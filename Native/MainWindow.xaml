<Window x:Class="TypeMaster.Native.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="TypeMaster" Width="1440" Height="852" MinWidth="320" MinHeight="240" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="#F5FAFE" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="23" ResizeBorderThickness="5" GlassFrameThickness="0" UseAeroCaptionButtons="False" CornerRadius="0"/></shell:WindowChrome.WindowChrome>
  <Grid x:Name="WindowSurface">
    <Grid.RowDefinitions><RowDefinition Height="23"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Background="#F7F2ED">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"><Image x:Name="CaptionIcon" Width="16" Height="16"/><TextBlock Text="TypeMaster" FontFamily="Segoe UI" FontSize="12" Foreground="Black" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel>
      <StackPanel x:Name="CaptionButtons" Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
    </Grid>
    <Grid Grid.Row="1" ClipToBounds="True">
      <Ellipse Fill="#0092EF" Width="766" Height="754" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-377,-433,0" IsHitTestVisible="False"/>
      <Ellipse Width="800" Height="800" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-559,0,0,-323" IsHitTestVisible="False"><Ellipse.Fill><LinearGradientBrush StartPoint="1,0" EndPoint="0,1"><GradientStop Color="#00277C" Offset="0"/><GradientStop Color="#043A9A" Offset="0.18"/><GradientStop Color="#0C46A7" Offset="0.24"/><GradientStop Color="#1B65D0" Offset="0.43"/><GradientStop Color="#509EFF" Offset="1"/></LinearGradientBrush></Ellipse.Fill></Ellipse>
      <Canvas Width="120" Height="78" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,-25" IsHitTestVisible="False">
        <Ellipse Canvas.Left="15" Canvas.Top="0" Width="5" Height="5" Fill="#00154B"/><Ellipse Canvas.Left="60" Canvas.Top="0" Width="5" Height="5" Fill="#00154B"/><Ellipse Canvas.Left="106" Canvas.Top="0" Width="5" Height="5" Fill="#00154B"/>
        <Ellipse Canvas.Left="15" Canvas.Top="34" Width="5" Height="5" Fill="#00154B"/><Ellipse Canvas.Left="60" Canvas.Top="34" Width="5" Height="5" Fill="#00154B"/><Ellipse Canvas.Left="106" Canvas.Top="34" Width="5" Height="5" Fill="#00154B"/>
        <Ellipse Canvas.Left="15" Canvas.Top="68" Width="5" Height="5" Fill="#00154B"/><Ellipse Canvas.Left="60" Canvas.Top="68" Width="5" Height="5" Fill="#00154B"/><Ellipse Canvas.Left="106" Canvas.Top="68" Width="5" Height="5" Fill="#00154B"/>
      </Canvas>
      <Viewbox x:Name="DisplayFit" Stretch="Uniform" StretchDirection="DownOnly" Margin="12,8">
      <Grid Width="790" Height="718">
      <Grid x:Name="ReferenceShell" Width="790" Height="628" VerticalAlignment="Top" HorizontalAlignment="Center">
        <Grid.RowDefinitions><RowDefinition Height="87"/><RowDefinition Height="541"/></Grid.RowDefinitions>
        <Image x:Name="BrandImage" Width="314" Height="64" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Border x:Name="WorkspaceFrame" Grid.Row="1" Background="{DynamicResource PanelBrush}" Padding="6">
          <Border.Effect><DropShadowEffect BlurRadius="120" ShadowDepth="14" Direction="270" Opacity="0.28" Color="#27334C"/></Border.Effect>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="NavColumn" Width="185"/></Grid.ColumnDefinitions>
            <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="PageContent" Margin="18,12"/></ScrollViewer>
            <Canvas x:Name="Navigation" Grid.Column="1" Background="{DynamicResource SidebarBrush}" Width="185" Height="529"/>
          </Grid>
        </Border>
      </Grid>
      </Grid>
      </Viewbox>
    </Grid>
  </Grid>
</Window>



