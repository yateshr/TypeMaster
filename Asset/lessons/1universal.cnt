begin chapter
nxxew keys=HOMEROW
new keys=SCAN:$21,$24
 chapter name=Day 1;Home Row - Index Fingers
 picture=none
 durationpercent=90
 extradescr=
 
 begin exercise
   type=Introduction
   duration=2
   EVENT=MESSAGE;3;Welcome to touch type! The HOME ROW is the middle row of keys where your fingers rest.;Getting Started;universal.png;right
   EVENT=MESSAGE;3;The HOME ROW has special tactile markers called "bumps" on certain keys to help you find your position without looking.;Bumps;universal.png;right
   EVENT=KEYINTRO;0;HOMEROW:HOMEROW;Press HomeRow;PRESS;SWAP;0;0;0;0;0;0;0;0;0
 end exercise

 begin exercise
   type=Index finger pairs
   duration=5
   EVENT=WORD2;5;PHYSGEN:fingers:4,5
 end exercise
new keys=SCAN:$23  
 begin exercise
   type=Right Index finger
   duration=4
   EVENT=KEY2;4;PHYSGEN:fingers:5|row:3
 end exercise
new keys=SCAN:$22 
 begin exercise
   type=Left Index finger
   duration=4
   EVENT=KEY2;4;PHYSGEN:fingers:4|row:3
 end exercise
 
 
 begin exercise
   type=Practice game
   duration=5
   EVENT=CLOUDS;3;PHYSGEN:fingers:4,5|row:3
 end exercise
 
 begin exercise
   type=Review drill
   duration=5
   EVENT=WORD2;5;PHYSGEN:fingers:4,5|row:3
 end exercise

end chapter

