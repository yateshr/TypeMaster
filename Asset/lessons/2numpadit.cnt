$description=Corso per tastiera numerica
$longdesc=Impara correttamente l'uso della tastiera numerica.
$version=1.00
$copyright=TMProductions 1999, all rights reserved.
$language=it

; excercises version 1.00
;****
; All rights reserved. (c) 1998 TMProductions
;****

wordloop=2
wordmaxloop=4
sentenceloop=0
sentencemaxloop=0

contents name=Numpad contents
keyboard=numpad.kbd
default time=0

; note, the wizardname entry below is empty by purpose
wizardname=


begin chapter
  chapter name=1;Numeri
  picture=ch1.pic
  durationpercent=99
  new keys=456789

  begin exercise
    type=Numeri 4-9
    duration=5
    Event=message;0;File:itnum2.int;Tastiera numerica;stdtip.bmp;left
    Event=message;0;File:itnum1.int;Num Lock;stdtip.bmp;left
    Event=NewKeys;1;file:num0101.exc;ENTER
  end exercise

  begin exercise
    type=Combinazioni
    duration=5
;    Event=message;0;File:uknum23.int;Istruzioni;stdtip.bmp;left
    Event=word;30;File:num0102.exc;ENTER
  end exercise

  new keys=1230

  begin exercise
    type=Numeri 1-3 e 0
    duration=4
;    Event=message;0;File:Ukbasi4.int;Fondamenta di dattilografia;stdtip.bmp;left
    Event=NewKeys;1;file:num0103a.exc;ENTER
    Event=NewKeys;1;file:num0103b.exc;ENTER
  end exercise

  begin exercise
    type=Combinazioni
    duration=5
    Event=Word;30;File:num0104.exc;ENTER
  end exercise

  begin exercise
    type=Le file
    duration=5
    Event=keyboard;30;File:num0105.exc;true
  end exercise

  begin exercise
    type=Gioco delle Bolliccine
    duration=3
    Event=bubbles;5;asdfjklei
  end exercise

  begin exercise
    type=Pratica
    duration=10
    Event=Text;30;File:num0107.exc;true
  end exercise


end chapter


// 2 chapter

begin chapter
  chapter name=2;Segni speciali
  picture=ch1.pic
  durationpercent=99
  new keys=+.

  begin exercise
    type=Nuovi tasti: + .
    duration=5
    Event=NewKeys;1;file:num0201.exc;ENTER
  end exercise

  begin exercise
    type=Combinazioni
    duration=5
    Event=word;30;File:num0202.exc;ENTER
  end exercise

  new keys=/*-

  begin exercise
    type=Nuovi tasti: / * -
    duration=4
    Event=NewKeys;1;file:num0203.exc;ENTER
  end exercise

  begin exercise
    type=Combinazioni
    duration=5
    Event=word;30;File:num0204.exc;ENTER
  end exercise

  begin exercise
    type=Le file
    duration=5
    Event=keyboard;30;File:num0205.exc;true
  end exercise

  begin exercise
    type=Gioco delle Bolliccine
    duration=3
    Event=bubbles;5;asdfjklei
  end exercise

  begin exercise
    type=Pratica
    duration=10
    Event=Text;30;File:num0207.exc;true
  end exercise


end chapter

begin chapter
  chapter name=3;Ricapitolazione
  picture=ch1.pic
  durationpercent=99

  begin exercise
    type=Numeri e punto
    duration=5
    Event=sentence;1;file:num0301.exc;true
  end exercise

  begin exercise
    type=Segni speciali
    duration=5
    Event=sentence;1;file:num0302.exc;true
  end exercise

  new keys=+
  begin exercise
    type=Gioco delle Bolliccine
    duration=3
    Event=bubbles;5;asdfjklei
  end exercise

  begin exercise
    type=Testo finale
    duration=10
    Event=Text;30;File:num0304.exc;true
  end exercise


end chapter



end contents
